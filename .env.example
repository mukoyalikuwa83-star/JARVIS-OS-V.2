# Copy this file to .env and fill in your values locally.
# Never commit .env to GitHub.

# Required for Google Gemini Live
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional: choose from SUPPORTED_VOICE_NAMES in main.py (case-insensitive)
# Example: puck, charon, kore, fenrir, aoede, leda, orus, schedar, zubenelgenubi
GEMINI_VOICE_NAME="puck"

# Optional Gmail Desktop OAuth client JSON. Gmail uses browser OAuth, never an API key.
#GMAIL_OAUTH_CLIENT_FILE="/absolute/path/to/client_secret_....json"

# Optional presentation model overrides
#PRESENTATION_QA_MODEL="gemini-2.5-flash"
#GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# Optional: for the local API (if you enable api.server)
#JARVIS_API_KEY="YOUR_PRIVATE_API_KEY"

# Optional: autonomy level. "autonomous" sends emails/messages without a
# confirmation gate; "balanced" (default) requires lightweight confirmation;
# "assisted" requires confirmation for any side-effecting action.
#JARVIS_AUTONOMY="balanced"

# Optional: assistant display name (defaults to "Assistant")
#ASSISTANT_NAME="Assistant"

# Optional: extra drive/volume roots the file_controller may read (semicolon-separated)
#JARVIS_ALLOWED_ROOTS="C:;D:"

# Optional: apps in which text entry stays fully guarded (semicolon-separated)
#JARVIS_BLOCKED_TYPING_APPS=""

# Optional: footer appended to outgoing messages (empty by default)
#MESSAGE_FOOTER=""
